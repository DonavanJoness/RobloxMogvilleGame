--!strict
-- A single portrait lookup shared by inventory, reveals, battles and plot labels.
-- PortraitAssets is generated by the asset pipeline and contains only Roblox IDs.
-- Zero means use the procedural portrait; no website URL or local file is shipped.
local Catalog: any = require(script.Parent.CharacterCatalog)
local PortraitAssets: any = require(script.Parent.PortraitAssets)
local CharacterVisuals = {}

export type Visual = {
	portraitAssetId: number,
	description: string,
	identityId: string,
	form: string,
	enabled: boolean,
	mutationEligible: boolean,
}

function CharacterVisuals.validAssetId(value: any): boolean
	return type(value) == "number" and value == value and value > 0
		and value <= 9007199254740991 and value % 1 == 0
end

function CharacterVisuals.get(characterId: any): Visual
	local definition = if type(characterId) == "string" then Catalog.Existing[characterId] or Catalog.Added[characterId] else nil
	if not definition then
		return {
			portraitAssetId = 0,
			description = "An original Mogville character. Portrait art is not configured for this entry.",
			identityId = "unknown", form = "Classic", enabled = false, mutationEligible = false,
		}
	end
	local mapped = PortraitAssets[characterId]
	local assetId = if CharacterVisuals.validAssetId(mapped) then mapped else 0
	return {
		portraitAssetId = assetId,
		description = definition.description,
		identityId = definition.identityId,
		form = definition.form,
		enabled = definition.enabled ~= false,
		mutationEligible = definition.mutationEligible ~= false,
	}
end

return CharacterVisuals
